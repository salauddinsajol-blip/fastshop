---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Cart – FastShop" description="Your shopping cart">
  <Navbar />
  <main class="flex-1 py-12 md:py-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-2xl md:text-3xl font-bold text-slate-800 mb-8">Your Cart</h1>
      <div id="cart-items" class="space-y-4">
        <!-- Filled by cart.js from LocalStorage -->
        <p class="text-slate-500 text-center py-8">Loading cart…</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
