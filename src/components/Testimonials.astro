---
const testimonials = [
  {
    quote: 'Quality is amazing and delivery was super fast. Will definitely order again.',
    name: 'Rahim Ahmed',
    location: 'Dhaka',
    rating: 5,
  },
  {
    quote: 'Best online clothing store in Bangladesh. Prices are fair and fabric is premium.',
    name: 'Fatima Khan',
    location: 'Chittagong',
    rating: 5,
  },
  {
    quote: 'Easy returns, great customer support. Highly recommend FastShop.',
    name: 'Karim Hossain',
    location: 'Sylhet',
    rating: 5,
  },
];
---

<section id="testimonials" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">What Our Customers Say</h2>
      <p class="text-slate-600 max-w-2xl mx-auto">Real reviews from real shoppers.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {testimonials.map((t) => (
        <blockquote class="bg-slate-50 rounded-2xl p-6 md:p-8 border border-slate-100 hover:border-emerald-100 hover:shadow-md transition-all">
          <div class="flex gap-1 mb-4 text-amber-400" aria-label={`${t.rating} out of 5 stars`}>
            {[...Array(t.rating)].map(() => (
              <span aria-hidden="true">★</span>
            ))}
          </div>
          <p class="text-slate-700 mb-6 leading-relaxed">"{t.quote}"</p>
          <footer>
            <p class="font-semibold text-slate-800">{t.name}</p>
            <p class="text-sm text-slate-500">{t.location}</p>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
