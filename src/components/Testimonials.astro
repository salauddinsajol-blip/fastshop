---
const testimonials = [
  {
    quote: 'The checklist got me live in under five minutes, and my audio finally sounds crisp.',
    name: 'Maya S.',
    location: 'Austin, TX',
    rating: 5,
  },
  {
    quote: 'A tripod and ring light doubled my watch time. The gear list is spot on.',
    name: 'Jordan Lee',
    location: 'Toronto',
    rating: 5,
  },
  {
    quote: 'The go-live script kept chat active and helped me hit a new follower milestone.',
    name: 'Priya K.',
    location: 'London',
    rating: 5,
  },
];
---

<section id="stories" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">Creator Stories</h2>
      <p class="text-slate-600 max-w-2xl mx-auto">Real results from creators who went live on mobile.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {testimonials.map((t) => (
        <blockquote class="bg-slate-50 rounded-2xl p-6 md:p-8 border border-slate-100 hover:border-emerald-100 hover:shadow-md transition-all">
          <div class="flex gap-1 mb-4 text-amber-400" aria-label={`${t.rating} out of 5 stars`}>
            {[...Array(t.rating)].map(() => (
              <span aria-hidden="true">★</span>
            ))}
          </div>
          <p class="text-slate-700 mb-6 leading-relaxed">"{t.quote}"</p>
          <footer>
            <p class="font-semibold text-slate-800">{t.name}</p>
            <p class="text-sm text-slate-500">{t.location}</p>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
