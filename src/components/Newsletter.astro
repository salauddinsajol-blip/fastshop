---

<section class="py-16 md:py-20 bg-gradient-to-br from-emerald-600 to-emerald-700">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Get Mobile Live Tips</h2>
    <p class="text-emerald-100 mb-8">
      Weekly checklists, streaming prompts, and creator workflows. No spam, unsubscribe anytime.
    </p>
    <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" action="#" method="post">
      <input
        type="email"
        name="email"
        placeholder="Enter your email"
        required
        class="flex-1 px-5 py-3.5 rounded-full text-slate-800 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-white/50"
      />
      <button
        type="submit"
        class="px-8 py-3.5 rounded-full bg-white text-emerald-700 font-semibold hover:bg-emerald-50 transition-colors"
      >
        Get the Tips
      </button>
    </form>
  </div>
</section>
