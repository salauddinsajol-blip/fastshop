---
const perks = [
  {
    title: 'Member Pricing',
    description: 'Save 15% on every order with exclusive pricing.',
  },
  {
    title: 'Priority Delivery',
    description: 'Express dispatch in 24-48 hours in major cities.',
  },
  {
    title: 'Exclusive Drops',
    description: 'Early access to limited editions and capsule releases.',
  },
  {
    title: 'Concierge Support',
    description: 'Personal styling help from our team every day.',
  },
];

const highlights = [
  'Free express shipping over BDT 1000',
  'VIP returns with pickup scheduling',
  'Birthday gifts and early access alerts',
];
---

<section id="premium" class="py-16 md:py-24 bg-slate-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <p class="text-amber-300 text-sm font-semibold uppercase tracking-widest mb-3">Premium Membership</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Upgrade every order with FastShop Premium</h2>
        <p class="text-slate-300 mb-8 max-w-xl">
          Get member-only pricing, early access to limited drops, and dedicated support built for premium
          shopping experiences.
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          {perks.map((perk) => (
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-4">
              <h3 class="font-semibold text-white mb-1">{perk.title}</h3>
              <p class="text-sm text-slate-300">{perk.description}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="relative">
        <div class="absolute -inset-4 rounded-3xl bg-amber-500/20 blur-2xl" aria-hidden="true"></div>
        <div class="relative bg-slate-800/90 border border-amber-500/40 rounded-3xl p-8 shadow-2xl">
          <div class="flex items-center justify-between mb-6">
            <div>
              <p class="text-sm text-amber-200 font-semibold uppercase tracking-widest">Premium Plan</p>
              <h3 class="text-2xl font-bold text-white">Monthly Membership</h3>
            </div>
            <span class="text-xs font-semibold bg-amber-400 text-slate-900 px-3 py-1 rounded-full uppercase tracking-wide">
              Most Popular
            </span>
          </div>
          <div class="flex items-end gap-2 mb-6">
            <span class="text-4xl font-bold text-white">BDT 499</span>
            <span class="text-sm text-slate-300">per month</span>
          </div>
          <ul class="space-y-3 mb-8">
            {highlights.map((item) => (
              <li class="flex items-start gap-3 text-slate-200 text-sm">
                <span class="mt-2 h-2 w-2 rounded-full bg-amber-400"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a
            href="#products"
            class="block text-center py-3 px-4 rounded-xl bg-amber-400 text-slate-900 font-semibold hover:bg-amber-300 transition-colors"
          >
            Start Premium
          </a>
          <p class="text-xs text-slate-400 mt-4">Cancel anytime. Member savings apply at checkout.</p>
        </div>
      </div>
    </div>
  </div>
</section>
