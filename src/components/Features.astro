---
const features = [
  {
    title: 'Choose your platform',
    description: 'Go where your audience already is, and enable live access in your account settings.',
    icon: '📺',
  },
  {
    title: 'Prep your setup',
    description: 'Clean the lens, lock orientation, enable Do Not Disturb, and test your mic.',
    icon: '🎛️',
  },
  {
    title: 'Light and frame',
    description: 'Face a light source, place the phone at eye level, and avoid cluttered backgrounds.',
    icon: '💡',
  },
  {
    title: 'Go live and engage',
    description: 'Open with a hook, read chat often, and save highlights for replays.',
    icon: '💬',
  },
];
---

<section id="steps" class="py-16 md:py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">Your Mobile Live Checklist</h2>
      <p class="text-slate-600 max-w-2xl mx-auto">Follow these four steps to go live fast without sacrificing quality.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {features.map((feature) => (
        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-slate-100 hover:shadow-md hover:border-emerald-100 transition-all">
          <div class="text-3xl mb-4" aria-hidden="true">{feature.icon}</div>
          <h3 class="text-lg font-semibold text-slate-800 mb-2">{feature.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
