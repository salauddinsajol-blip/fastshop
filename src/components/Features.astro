---
const features = [
  {
    title: 'Priority Delivery',
    description: 'Express dispatch with premium handling.',
    icon: '🚚',
  },
  {
    title: 'Premium Fabrics',
    description: 'Long-staple cotton, merino, and artisan blends.',
    icon: '🧵',
  },
  {
    title: 'Member Pricing',
    description: 'Exclusive prices reserved for premium members.',
    icon: '🏷️',
  },
  {
    title: 'Concierge Support',
    description: 'Personal styling help whenever you need it.',
    icon: '🎧',
  },
];
---

<section id="features" class="py-16 md:py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">Premium Service, Every Order</h2>
      <p class="text-slate-600 max-w-2xl mx-auto">Designed for premium shopping from checkout to delivery.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {features.map((feature) => (
        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-slate-100 hover:shadow-md hover:border-amber-200 transition-all">
          <div class="text-3xl mb-4" aria-hidden="true">{feature.icon}</div>
          <h3 class="text-lg font-semibold text-slate-800 mb-2">{feature.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
