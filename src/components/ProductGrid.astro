---
import ProductCard from './ProductCard.astro';

const products = [
  { name: 'Pocket Tripod Stand', price: 29, image: 'https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=400&h=400&fit=crop', badge: 'Starter' },
  { name: 'Clip-on Lavalier Mic', price: 39, image: 'https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=400&h=400&fit=crop' },
  { name: 'Compact Ring Light', price: 49, image: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=400&h=400&fit=crop', badge: 'Best for Lighting' },
  { name: '3-Axis Phone Gimbal', price: 89, image: 'https://images.unsplash.com/photo-1516726817505-f5ed825624d8?w=400&h=400&fit=crop' },
  { name: 'High-Capacity Power Bank', price: 45, image: 'https://images.unsplash.com/photo-1512403754473-27835f7b9984?w=400&h=400&fit=crop' },
  { name: 'Portable Wi-Fi Hotspot', price: 79, image: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=400&h=400&fit=crop', badge: 'Go Live Anywhere' },
];
---

<section id="gear" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">Recommended Mobile Live Gear</h2>
      <p class="text-slate-600 max-w-2xl mx-auto">Affordable essentials to stabilize video, improve audio, and keep you live longer.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {products.map((product) => (
        <ProductCard
          image={product.image}
          name={product.name}
          price={product.price}
          badge={product.badge}
        />
      ))}
    </div>
  </div>
</section>
