---
---

<section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-amber-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 lg:py-14">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="text-center lg:text-left">
        <p class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-amber-300 text-sm font-medium mb-6 border border-white/20">
          Premium Tier Now Live
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          Premium Essentials for
          <span class="text-amber-300">Everyday Comfort</span>
        </h1>
        <p class="text-lg text-slate-300 mb-8 max-w-xl mx-auto lg:mx-0">
          Member-only pricing, early access drops, and concierge support. Free express delivery on orders over BDT 1000.
        </p>
        <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
          <a
            href="#products"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-amber-500 text-slate-900 font-semibold hover:bg-amber-400 shadow-lg shadow-amber-500/25 transition-all"
          >
            Shop Premium Picks
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="#premium"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full border-2 border-white/40 text-white font-semibold hover:bg-white/10 hover:border-amber-300/60 transition-colors"
          >
            View Premium Benefits
          </a>
        </div>
      </div>
      <div class="relative flex justify-center lg:justify-end">
        <div class="relative w-full max-w-md aspect-square rounded-3xl overflow-hidden ring-2 ring-white/20 shadow-2xl">
          <img
            src="/hero-image.svg"
            alt="Fashion collection"
            class="w-full h-full object-cover"
            width="600"
            height="600"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
