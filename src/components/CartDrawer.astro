---
---

<div id="cart-drawer" class="fixed inset-0 z-[100] pointer-events-none" aria-hidden="true">
  <!-- Overlay -->
  <div
    id="cart-drawer-overlay"
    class="cart-drawer-overlay fixed inset-0 bg-black/50 z-[100] opacity-0 transition-opacity duration-300 ease-out"
    tabindex="-1"
  ></div>
  <!-- Panel -->
  <div
    id="cart-drawer-panel"
    class="cart-drawer-panel fixed top-0 right-0 h-full w-full max-w-md bg-white shadow-xl z-[101] flex flex-col transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between p-4 border-b border-slate-200">
      <h2 class="text-lg font-bold text-slate-800">Your Cart</h2>
      <button
        type="button"
        id="cart-drawer-close"
        class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-colors"
        aria-label="Close cart"
      >
        <span aria-hidden="true">✕</span>
      </button>
    </div>
    <div id="cart-drawer-items" class="flex-1 overflow-y-auto p-4">
      <!-- Filled by cart.js -->
      <p class="text-slate-500 text-center py-8 text-sm">Cart is empty.</p>
    </div>
    <div class="p-4 border-t border-slate-200 space-y-4">
      <div class="flex justify-between text-slate-800 font-semibold">
        <span>Subtotal</span>
        <span id="cart-drawer-subtotal">৳0</span>
      </div>
      <a
        href="/cart"
        id="cart-drawer-checkout"
        class="block w-full py-3 px-4 rounded-xl bg-amber-500 text-slate-900 font-semibold text-center hover:bg-amber-400 transition-colors"
      >
        Proceed to Checkout
      </a>
    </div>
  </div>
</div>

<style is:global>
  #cart-drawer .cart-drawer-panel {
    transform: translateX(100%);
  }
  #cart-drawer.is-open {
    pointer-events: auto;
  }
  #cart-drawer.is-open .cart-drawer-overlay {
    opacity: 1;
  }
  #cart-drawer.is-open .cart-drawer-panel {
    transform: translateX(0) !important;
  }
</style>
