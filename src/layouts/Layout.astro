---
import '../styles/global.css';
import CartDrawer from '../components/CartDrawer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'FastShop – Smart Fashion for Everyday Comfort', description = 'Simple, premium quality clothing at honest prices. Free delivery on orders over ৳১,০০০.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
  </head>
  <body class="antialiased text-slate-800 min-h-screen flex flex-col" style="font-family: 'DM Sans', system-ui, sans-serif;">
    <slot />
    <CartDrawer />
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var drawer = document.getElementById('cart-drawer');
        var trigger = document.querySelector('.cart-drawer-trigger');
        var overlay = document.getElementById('cart-drawer-overlay');
        var closeBtn = document.getElementById('cart-drawer-close');
        function openDrawer() {
          if (drawer) {
            drawer.classList.add('is-open');
            drawer.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }
        }
        function closeDrawer() {
          if (drawer) {
            drawer.classList.remove('is-open');
            drawer.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }
        }
        if (trigger) trigger.addEventListener('click', function (e) { e.preventDefault(); openDrawer(); });
        if (overlay) overlay.addEventListener('click', closeDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      });
    </script>
    <script is:inline src="/js/cart.js"></script>
  </body>
</html>
